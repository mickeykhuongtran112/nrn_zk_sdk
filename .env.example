# Reference settings for opt-in hardware tests.
# The SDK and pytest do NOT automatically load this file.
# Export the variables in your shell; see docs/validation.md.
ZK_HARDWARE_PORT=
ZK_BAUDRATE=115200
ZK_ANTENNA_PORTS=1
ZK_MODEL=
ZK_FIRMWARE=

# Keep writes disabled unless using a known, writable scratch tag.
ZK_ALLOW_TAG_WRITE=0
ZK_TEST_TID=
ZK_USER_WORD_ADDRESS=0
