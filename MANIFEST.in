include README.md CHANGELOG.md CONTRIBUTING.md LICENSE pyproject.toml MANIFEST.in
include src/zk_rfid.py
recursive-include docs *.md *.json *.svg
recursive-include examples *.py *.html *.css *.js *.md
recursive-include web *.py *.js *.ts *.md
recursive-include tools *.py
recursive-include tests *.py *.md *.mjs *.cjs *.html *.css *.js
recursive-include fixtures *.md *.json *.hex
include compat/nation/nrn.py compat/nation/LICENSE compat/nation/UPSTREAM.md compat/nation/README.md compat/nation/CHANGELOG.md compat/nation/mapping_cases.json
prune local_data
prune .codex
prune Protocol_ZK
prune Protocol_NATION
prune Mode_research
prune .venv
prune artifacts
prune tmp
prune vendor
prune captures
prune logs
prune node_modules
prune .github
global-exclude __pycache__ *.py[cod] plan_agent*.md .env .env.* *.pem *.key *.p12 *.pfx *.dll *.exe *.so *.dylib
