include README.md CHANGELOG.md LICENSE plan_agent.md pyproject.toml MANIFEST.in
recursive-include src *.py py.typed
recursive-include docs *.md *.json
recursive-include examples *.py
recursive-include tools *.py
recursive-include tests *.py *.md *.mjs *.cjs *.html *.css *.js
recursive-include fixtures *.md *.json *.hex
include compat/nation/nrn.py compat/nation/LICENSE compat/nation/UPSTREAM.md compat/nation/README.md compat/nation/CHANGELOG.md compat/nation/mapping_cases.json
prune local_data
prune Protocol_ZK
prune Protocol_NATION
prune Mode_research
prune .venv
prune artifacts
prune tmp
global-exclude __pycache__ *.py[cod]
